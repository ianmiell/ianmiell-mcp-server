[Unit]
Description=Ian Miell MCP Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=imiell
Group=imiell
WorkingDirectory=/opt/ianmiell-mcp-server
EnvironmentFile=/etc/default/ianmiell-mcp-server
ExecStart=/opt/ianmiell-mcp-server/ianmiell-mcp-server
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ianmiell-mcp-server

[Install]
WantedBy=multi-user.target
